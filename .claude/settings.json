{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(nmap:*)",
      "Bash(curl:*)",
      "Bash(whois:*)",
      "Bash(dig:*)",
      "Bash(nslookup:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(*)",
      "Write",
      "Edit"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(:(){ :|:& };:)",
      "Bash(hping3:*)",
      "Bash(slowloris:*)",
      "Bash(msfconsole:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scope-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/log-evidence.py"
          }
        ]
      }
    ]
  }
}
